// Hébergement du build WebGL sur Cloudflare Workers (fichiers statiques + petit Worker).
// Déploiement : voir Cloudflare/README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vestige",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    // Copie du build préparée par scripts/build.mjs (gros fichiers découpés), à partir de ../Builds/WebGL.
    "directory": "./dist",
    "binding": "ASSETS",
    // Le Worker ne s'exécute que pour Build/* : il pose Content-Encoding sur les .unityweb.
    // Tout le reste (index.html, StreamingAssets…) est servi directement par Cloudflare.
    "run_worker_first": ["/Build/*"]
  },

  // Cloudflare crée lui-même l'enregistrement DNS et le certificat (zone brozen.fr déjà sur Cloudflare).
  "routes": [
    { "pattern": "vestige.brozen.fr", "custom_domain": true }
  ]
}
